# ==============================================================================
# API Keys (Required)
# ==============================================================================
# Get your Firecrawl API key from: https://firecrawl.dev
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY_HERE

# Get your Apify API token from: https://apify.com/settings/tokens
APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN_HERE

# ==============================================================================
# Supabase Configuration (Required for Backend)
# ==============================================================================
# Get your Supabase project URL and keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY_HERE

# ==============================================================================
# Ollama Configuration (Optional - defaults provided)
# ==============================================================================
OLLAMA_HOST=http://localhost:11434
ORCHESTRATOR_MODEL=gpt-oss:120b-cloud
EXTRACTOR_MODEL=gpt-oss:20b-cloud
ENRICHER_MODEL=gpt-oss:20b-cloud

# ==============================================================================
# Crawl4AI Settings (Optional)
# ==============================================================================
CRAWL4AI_HEADLESS=true
CRAWL4AI_TIMEOUT=30

# ==============================================================================
# Logging (Optional)
# ==============================================================================
LOG_LEVEL=INFO
LOG_DIR=logs/

# ==============================================================================
# Artifacts (Optional)
# ==============================================================================
ARTIFACT_DIR=artifacts/

# ==============================================================================
# CORS Configuration (Optional)
# ==============================================================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS="https://your-app.vercel.app,https://your-other-app.vercel.app"