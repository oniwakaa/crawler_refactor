# API Keys
FIRECRAWL_API_KEY=your_api_key_here
OLLAMA_HOST=http://localhost:11434

# Ollama Models
ORCHESTRATOR_MODEL=gpt-oss:120b-cloud # suggested 
EXTRACTOR_MODEL=gpt-oss:20b-cloud     # suggested
ENRICHER_MODEL=gpt-oss:20b-cloud      # suggested
VALIDATOR_MODEL=gpt-oss:20b-cloud     # suggested

# Crawl4AI Settings
CRAWL4AI_HEADLESS=true # False for opening browser 
CRAWL4AI_TIMEOUT=30    # seconds 

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/

# Artifacts
ARTIFACT_DIR=artifacts/